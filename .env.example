# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Optional: a form endpoint (e.g. Formspree https://formspree.io/f/xxxx). Leave empty to use the mailto fallback.
NEXT_PUBLIC_CONTACT_ENDPOINT=
# Optional: LinkedIn profile URL. Leave empty to hide the LinkedIn link.
NEXT_PUBLIC_LINKEDIN_URL=
